<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mindful.unlock.reminder">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.UnlockReminder"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MessageDialogActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"/>

        <!--
            UnlockReceiver must be exported so the system can deliver ACTION_USER_PRESENT.
            It also handles BOOT_COMPLETED to restart the foreground monitor service after reboot.
            We validate the action explicitly inside onReceive() for safety.
        -->
        <receiver
            android:name=".receiver.UnlockReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
            </intent-filter>
        </receiver>

        <!--
            UnlockMonitorService keeps the app process resident so the OS does not freeze it
            (Android 14+ Cached App Freezer). This ensures UnlockReceiver reliably receives
            ACTION_USER_PRESENT while the reminder is enabled.
        -->
        <service
            android:name=".service.UnlockMonitorService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the process alive so ACTION_USER_PRESENT is reliably delivered on Android 14+ devices that use the Cached App Freezer."/>
        </service>

    </application>
</manifest>
